FROM eclipse-temurin:25-jdk AS linux-jdk

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
RUN dpkg --add-architecture i386 && \
    apt-get update && \
    apt-get install -y --no-install-recommends wine wine64 wine32 curl ca-certificates python3 unzip procps && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/win-jdk && \
    curl -sSL "https://api.adoptium.net/v3/binary/latest/25/ga/windows/x64/jdk/hotspot/normal/eclipse" -o /tmp/win-jdk.zip && \
    unzip -q /tmp/win-jdk.zip -d /opt/win-jdk && \
    rm /tmp/win-jdk.zip && \
    mv /opt/win-jdk/jdk* /opt/win-jdk/current

COPY --from=linux-jdk /opt/java/openjdk/lib/security/cacerts /opt/win-jdk/current/lib/security/cacerts
COPY --from=linux-jdk /opt/java/openjdk /opt/linux-jdk
ENV PATH="/opt/linux-jdk/bin:${PATH}"

ENV WINEDEBUG=-all
RUN wineboot --init

WORKDIR /server

COPY test_server.py /test_server.py

CMD ["python3", "/test_server.py", "--windows"]